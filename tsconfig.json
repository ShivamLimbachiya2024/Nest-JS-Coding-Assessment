{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "paths": {
      "auth": ["./libs/auth/src/index.ts"],
      "auth/*": ["./libs/auth/src/*"],
      "common": ["./libs/common/src/index.ts"],
      "common/*": ["./libs/common/src/*"],
      "config": ["./libs/config/src/index.ts"],
      "config/*": ["./libs/config/src/*"],
      "contracts": ["./libs/contracts/src/index.ts"],
      "contracts/*": ["./libs/contracts/src/*"],
      "database": ["./libs/database/src/index.ts"],
      "database/*": ["./libs/database/src/*"],
      "database/user-service": ["./libs/database/src/user-service/index.ts"],
      "database/task-service": ["./libs/database/src/task-service/index.ts"],
      "database/notification-service": [
        "./libs/database/src/notification-service/index.ts"
      ],
      "logger": ["./libs/logger/src/index.ts"],
      "logger/*": ["./libs/logger/src/*"],
      "rabbitmq": ["./libs/rabbitmq/src/index.ts"],
      "rabbitmq/*": ["./libs/rabbitmq/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/task-service/tsconfig.app.json"
    },
    {
      "path": "./apps/notification-service/tsconfig.app.json"
    }
  ]
}
