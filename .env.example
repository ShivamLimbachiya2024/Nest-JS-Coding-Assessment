NODE_ENV=development
SERVICE_NAME=user-service

USER_SERVICE_PORT=3001
TASK_SERVICE_PORT=3002
NOTIFICATION_SERVICE_PORT=3003

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=taskflow

RABBITMQ_URL=amqp://taskflow:taskflow-dev-password@localhost:5672
WORKER_QUEUE=taskflow-user-verification
WORKER_PREFETCH=10

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ISSUER=taskflow-user-service
JWT_AUDIENCE=taskflow-services
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ACCESS_COOKIE_NAME=taskflow_access_token
REFRESH_COOKIE_NAME=taskflow_refresh_token
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
