{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "TaskFlow three-service NestJS assessment",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build-user && npm run build-task && npm run build-notification && npm run build-user-worker && npm run build-notification-worker && npm run build-task-outbox",
    "build-user": "nest build user-service",
    "build-task": "nest build task-service",
    "build-notification": "nest build notification-service",
    "build-user-worker": "nest build user-worker",
    "build-notification-worker": "nest build notification-worker",
    "build-task-outbox": "nest build task-outbox",
    "format": "prettier --write \"{apps,libs,scripts}/**/*.{ts,mjs}\" \"*.json\" README.md \"*.yml\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "format-check": "prettier --check \"{apps,libs,scripts}/**/*.{ts,mjs}\" \"*.json\" README.md \"*.yml\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "lint": "oxlint apps libs scripts --deny-warnings",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json --pretty false",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test-watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test-coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test-e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest-e2e.config.cjs --runInBand",
    "check-policy": "node scripts/check-repository-policy.mjs",
    "verify": "npm run check-policy && npm run format-check && npm run lint && npm run typecheck && npm test && npm run build",
    "start-user-dev": "nest start user-service --watch",
    "start-task-dev": "nest start task-service --watch",
    "start-notification-dev": "nest start notification-service --watch",
    "start-user-worker-dev": "nest start user-worker --watch",
    "start-notification-worker-dev": "nest start notification-worker --watch",
    "start-task-outbox-dev": "nest start task-outbox --watch",
    "start-user": "node dist/apps/user-service/main.js",
    "start-task": "node dist/apps/task-service/main.js",
    "start-notification": "node dist/apps/notification-service/main.js",
    "start-user-worker": "node dist/apps/user-service/worker.js",
    "start-notification-worker": "node dist/apps/notification-service/worker.js",
    "start-task-outbox": "node dist/apps/task-service/outbox.js",
    "migration-generate-user": "typeorm-ts-node-esm migration:generate libs/database/src/migrations/user-service/initial-user-schema -d libs/database/src/data-sources/user.data-source.ts",
    "migration-generate-task": "typeorm-ts-node-esm migration:generate libs/database/src/migrations/task-service/initial-task-schema -d libs/database/src/data-sources/task.data-source.ts",
    "migration-generate-notification": "typeorm-ts-node-esm migration:generate libs/database/src/migrations/notification-service/initial-notification-schema -d libs/database/src/data-sources/notification.data-source.ts",
    "migration-run-user": "typeorm-ts-node-esm migration:run -d libs/database/src/data-sources/user.data-source.ts",
    "migration-run-task": "typeorm-ts-node-esm migration:run -d libs/database/src/data-sources/task.data-source.ts",
    "migration-run-notification": "typeorm-ts-node-esm migration:run -d libs/database/src/data-sources/notification.data-source.ts",
    "migration-revert-user": "typeorm-ts-node-esm migration:revert -d libs/database/src/data-sources/user.data-source.ts",
    "migration-revert-task": "typeorm-ts-node-esm migration:revert -d libs/database/src/data-sources/task.data-source.ts",
    "migration-revert-notification": "typeorm-ts-node-esm migration:revert -d libs/database/src/data-sources/notification.data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/typeorm": "12.0.2",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "lodash": "4.18.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@rspack/core": "2.3.0",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.10.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typeorm-ts-node-esm": "0.3.20",
    "typescript": "6.0.2",
    "webpack-node-externals": "3.0.0"
  }
}
