NODE_ENV=development
SERVICE_NAME=user-service
USER_SERVICE_PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=taskflow

RABBITMQ_URL=amqp://rabbit:rabbitmq-dev-password@localhost:5672
WORKER_PREFETCH=10

# Keep the access-token settings identical across all three service configurations.
JWT_ACCESS_SECRET=replace-with-a-shared-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ISSUER=user-service
JWT_AUDIENCE=services
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
